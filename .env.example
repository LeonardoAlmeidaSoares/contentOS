# ContentOS — copie para .env (docker compose usa estes valores; defaults de dev já funcionam)
COMPOSE_PROJECT_NAME=contentos

# Frontend: IP de bind na LAN (192.168.18.2 = servidor Kahi; use 127.0.0.1 para somente local).
# A API (8301) permanece sempre em 127.0.0.1. Nunca expor à internet: não há autenticação.
WEB_BIND_IP=192.168.18.2
WEB_PORT=8300
API_PORT=8301

POSTGRES_USER=contentos
POSTGRES_PASSWORD=contentos_dev_pw
POSTGRES_DB=contentos

MINIO_ROOT_USER=contentos
MINIO_ROOT_PASSWORD=contentos_dev_pw
MINIO_BUCKET=contentos-artifacts

# Atenção: valores abaixo são montados no compose a partir dos de cima.
# DATABASE_URL, REDIS_URL e MINIO_ENDPOINT são definidos em docker-compose.yml.

# Segurança (obrigatórios). Gere valores próprios:
#   ADMIN_TOKEN:      openssl rand -base64 24 | tr -d '/+='
#   CREDENTIALS_KEY:  python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  (pip install cryptography)
# Faça backup de CREDENTIALS_KEY: sem ela as credenciais de provedores salvas ficam ilegíveis.
ADMIN_TOKEN=
CREDENTIALS_KEY=
# Teto mensal (USD) de gastos do Laboratório
LAB_MONTH_LIMIT_USD=10

# Estúdio de vídeos
# Gemini (obrigatório para criar fábricas por conversa e gerar roteiros). Chave gratuita: https://aistudio.google.com/apikey
# Use uma chave de projeto SEM faturamento para garantir custo zero. A chave fica só aqui (nunca no banco/código).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Opcional: imagens da Pexels (chave gratuita em https://www.pexels.com/api/). Sem ela, usa Wikimedia Commons.
PEXELS_API_KEY=

# YouTube (publicação privada). Cliente OAuth tipo "App para computador" no Google Cloud (ver README/entrega da Missão 2).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
